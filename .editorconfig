# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

[*.nix]
indent_style = space
indent_size = 2

[*.md]
max_line_length = 80

# Golden emit fixtures may carry long JSON-quoted description lines.
[nix/dotagents/fixtures/**]
max_line_length = off
